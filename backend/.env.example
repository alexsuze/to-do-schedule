# 本機開發用，複製為 .env 後填入（Spring Boot 不會自動讀 .env，請以 IDE 或 shell 匯出環境變數）
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/todo_schedule
API_TOKEN=change-me
CORS_ALLOWED_ORIGIN=http://localhost:5173
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:5173
